# Documentation template only. Copy this file to .env before running the stack.
# Every value below is fake and intended only for local development.

POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=platform_admin
POSTGRES_ADMIN_PASSWORD=dev-only-admin-password-ChangeMe-2026

APP_DB_NAME=onboarding_app
APP_DB_USER=onboarding_app_user
APP_DB_PASSWORD=dev-only-app-db-password-ChangeMe-2026

MIGRATION_DB_USER=onboarding_migration_user
MIGRATION_DB_PASSWORD=dev-only-migration-password-ChangeMe-2026

TEST_DB_NAME=onboarding_test
TEST_DB_USER=onboarding_test_user
TEST_DB_PASSWORD=dev-only-test-password-ChangeMe-2026

SHADOW_DB_NAME=onboarding_shadow

N8N_DB_NAME=n8n_internal
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=dev-only-n8n-db-password-ChangeMe-2026

# Keep this stable across n8n restarts. Use a unique random value outside local development.
N8N_ENCRYPTION_KEY=dev-only-n8n-encryption-key-0000000000000000
N8N_PORT=5678

# Used when the Next.js app runs directly on the host.
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
DATABASE_URL=postgresql://onboarding_app_user:dev-only-app-db-password-ChangeMe-2026@127.0.0.1:5432/onboarding_app
# Used only by Prisma migration commands.
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
MIGRATION_DATABASE_URL=postgresql://onboarding_migration_user:dev-only-migration-password-ChangeMe-2026@127.0.0.1:5432/onboarding_app
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
SHADOW_DATABASE_URL=postgresql://onboarding_migration_user:dev-only-migration-password-ChangeMe-2026@127.0.0.1:5432/onboarding_shadow
# Integration queries use the restricted test runtime user.
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
TEST_DATABASE_URL=postgresql://onboarding_test_user:dev-only-test-password-ChangeMe-2026@127.0.0.1:5432/onboarding_test
# Destructive test setup uses migration credentials only against onboarding_test.
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
TEST_MIGRATION_DATABASE_URL=postgresql://onboarding_migration_user:dev-only-migration-password-ChangeMe-2026@127.0.0.1:5432/onboarding_test

# Replace in the ignored .env file. Never reuse outside local development.
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_URL=http://127.0.0.1:3000
DEMO_STAFF_PASSWORD=replace-with-a-local-demo-password
LOG_LEVEL=info
WEB_PORT=3000
PLAYWRIGHT_PORT=3100
