{
  "name": "client-onboarding-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "pnpm --filter @client-onboarding/web build",
    "ci": "pnpm verify",
    "db:bootstrap": "docker compose --env-file .env run --rm db-bootstrap",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:reset:test": "prisma migrate reset --force --config prisma.test.config.ts",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "dev": "node scripts/dev-web.mjs",
    "docker:config": "docker compose --env-file .env config",
    "docker:down": "docker compose --env-file .env down",
    "docker:logs": "docker compose --env-file .env logs --follow",
    "docker:up": "docker compose --env-file .env up --build -d",
    "docs:links": "node scripts/validate-doc-links.mjs",
    "docs:mermaid:validate": "node scripts/validate-mermaid.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "git:diff-check": "node scripts/git-diff-check.mjs",
    "history:scan": "node scripts/scan-git-history.mjs",
    "lint": "pnpm --filter @client-onboarding/web lint",
    "n8n:validate": "node scripts/validate-n8n-workflows.mjs",
    "secret:scan": "secretlint \"**/*\" \".env.example\"",
    "screenshots:scan": "node scripts/scan-screenshots.mjs",
    "demo:phase7": "node scripts/phase7-demo.mjs verify",
    "demo:phase7:cleanup": "node scripts/phase7-demo.mjs cleanup",
    "smoke:phase3": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/phase3-smoke-activate.ts",
    "smoke:phase4": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/phase4-smoke.ts",
    "smoke:phase4:resume": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/phase4-smoke-resume.ts",
    "smoke:phase5": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/phase5-smoke.ts",
    "smoke:phase5:failed-delivery": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/phase5-failed-delivery-smoke.ts",
    "inspect:phase6:pending": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/phase6-inspect-pending.ts",
    "smoke:phase6": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/phase6-smoke.ts",
    "smoke:phase6:uncertain-delivery": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/phase6-uncertain-delivery-smoke.ts",
    "test": "pnpm --filter @client-onboarding/web test",
    "test:e2e": "pnpm --filter @client-onboarding/web test:e2e",
    "test:integration": "pnpm --filter @client-onboarding/web test:integration",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "pnpm --filter @client-onboarding/web typecheck",
    "verify": "pnpm db:validate && pnpm n8n:validate && pnpm docs:links && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:e2e && pnpm build && pnpm secret:scan && pnpm audit --prod --audit-level high && pnpm git:diff-check",
    "verify:final": "node scripts/verify-final.mjs"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "dotenv": "17.4.2",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "secretlint": "13.0.5",
    "tsx": "4.23.12"
  }
}
