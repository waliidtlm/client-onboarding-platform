generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  OPERATIONS
  FINANCE
  PROJECT_MANAGER
  DELIVERY
}

enum ActivationType {
  FULL_PAYMENT_PERCENTAGE
  DEPOSIT_PERCENTAGE
  FIXED_DEPOSIT_AMOUNT
  MANUAL_APPROVAL
}

enum RequirementInputType {
  TEXT
  URL
  FILE
  MULTI_FILE
}

enum OnboardingStatus {
  SALES_HANDOFF_INCOMPLETE
  COMMERCIAL_PENDING
  READY_FOR_ONBOARDING
  INTERNAL_SETUP
  INTERNAL_REVIEW
  CLIENT_AWAITING_ACTION
  CLIENT_REQUIREMENTS_COMPLETE
  KICKOFF_PENDING
  PROJECT_READY
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum SalesHandoffStatus {
  PENDING_VALIDATION
  INCOMPLETE
  COMPLETE
}

enum DealStatus {
  OPEN
  CLOSED_WON
  CLOSED_LOST
}

enum CommercialGateStatus {
  BLOCKED
  PENDING_REVIEW
  APPROVED
  CANCELLED
}

enum ActivationRequirementStatus {
  NOT_SATISFIED
  MANUAL_REVIEW_REQUIRED
  SATISFIED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  REVISION_REQUESTED
  SIGNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REVIEW_REQUIRED
  REJECTED
}

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String       @db.VarChar(200)
  email              String       @unique @db.VarChar(320)
  passwordHash       String       @db.VarChar(255)
  role               Role
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  managedOnboardings Onboarding[] @relation("ProjectManager")
  submittedRecords   Onboarding[] @relation("SubmittedBy")
  validatedRecords   Onboarding[] @relation("ValidatedBy")
  submittedPayments  Payment[]    @relation("PaymentSubmittedBy")
  verifiedPayments   Payment[]    @relation("PaymentVerifiedBy")
}

model Client {
  id           String       @id @default(uuid()) @db.Uuid
  companyName  String       @unique @db.VarChar(200)
  contactName  String       @db.VarChar(200)
  contactEmail String       @db.VarChar(320)
  contactPhone String?      @db.VarChar(50)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  onboardings  Onboarding[]
}

model ServicePackage {
  id                    String                        @id @default(uuid()) @db.Uuid
  name                  String                        @unique @db.VarChar(200)
  description           String
  isActive              Boolean                       @default(true)
  activationType        ActivationType
  activationValue       Decimal                       @db.Decimal(19, 4)
  createdAt             DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                      @updatedAt @db.Timestamptz(3)
  provisioningTemplates PackageProvisioningTemplate[]
  requirementTemplates  PackageRequirementTemplate[]
  onboardings           Onboarding[]
}

model PackageProvisioningTemplate {
  id               String         @id @default(uuid()) @db.Uuid
  servicePackageId String         @db.Uuid
  name             String         @db.VarChar(200)
  description      String
  sequence         Int
  isRequired       Boolean        @default(true)
  automationKey    String         @db.VarChar(100)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)

  @@unique([servicePackageId, sequence])
  @@unique([servicePackageId, automationKey])
}

model PackageRequirementTemplate {
  id               String               @id @default(uuid()) @db.Uuid
  servicePackageId String               @db.Uuid
  name             String               @db.VarChar(200)
  description      String
  inputType        RequirementInputType
  isRequired       Boolean              @default(true)
  sequence         Int
  dueOffsetDays    Int
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  servicePackage   ServicePackage       @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)

  @@unique([servicePackageId, sequence])
}

model Onboarding {
  id                          String                      @id @default(uuid()) @db.Uuid
  clientId                    String                      @db.Uuid
  servicePackageId            String                      @db.Uuid
  externalDealId              String?                     @unique @db.VarChar(200)
  dealStatus                  DealStatus
  salesHandoffStatus          SalesHandoffStatus
  commercialGateStatus        CommercialGateStatus
  status                      OnboardingStatus
  projectManagerId            String?                     @db.Uuid
  submittedById               String                      @db.Uuid
  validatedById               String?                     @db.Uuid
  invoiceTotal                Decimal                     @db.Decimal(19, 4)
  currency                    String                      @db.Char(3)
  activationRequiredAmount    Decimal                     @db.Decimal(19, 4)
  activationRequirementStatus ActivationRequirementStatus
  activatedAt                 DateTime?                   @db.Timestamptz(3)
  welcomeEmailSentAt          DateTime?                   @db.Timestamptz(3)
  requirementsCompletedAt     DateTime?                   @db.Timestamptz(3)
  projectReadyAt              DateTime?                   @db.Timestamptz(3)
  completedAt                 DateTime?                   @db.Timestamptz(3)
  cancelledAt                 DateTime?                   @db.Timestamptz(3)
  cancellationReason          String?
  version                     Int                         @default(1)
  createdAt                   DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                    @updatedAt @db.Timestamptz(3)
  client                      Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  servicePackage              ServicePackage              @relation(fields: [servicePackageId], references: [id], onDelete: Restrict)
  projectManager              User?                       @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  submittedBy                 User                        @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  validatedBy                 User?                       @relation("ValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  contracts                   Contract[]
  invoices                    Invoice[]

  @@unique([id, currency])
  @@index([status, createdAt])
  @@index([projectManagerId])
}

model Contract {
  id                String         @id @default(uuid()) @db.Uuid
  onboardingId      String         @db.Uuid
  status            ContractStatus
  versionNumber     Int
  signatureDeadline DateTime?      @db.Timestamptz(3)
  signedAt          DateTime?      @db.Timestamptz(3)
  revisionReason    String?
  externalReference String?        @unique @db.VarChar(200)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  onboarding        Onboarding     @relation(fields: [onboardingId], references: [id], onDelete: Restrict)

  @@unique([onboardingId, versionNumber])
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  onboardingId      String        @db.Uuid
  status            InvoiceStatus
  invoiceNumber     String        @unique @db.VarChar(100)
  totalAmount       Decimal       @db.Decimal(19, 4)
  currency          String        @db.Char(3)
  dueAt             DateTime      @db.Timestamptz(3)
  overdueAt         DateTime?     @db.Timestamptz(3)
  externalReference String?       @unique @db.VarChar(200)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  onboarding        Onboarding    @relation(fields: [onboardingId, currency], references: [id, currency], onDelete: Restrict)
  payments          Payment[]

  @@unique([id, currency])
  @@index([onboardingId])
}

model Payment {
  id                 String                    @id @default(uuid()) @db.Uuid
  invoiceId          String                    @db.Uuid
  originalAmount     Decimal                   @db.Decimal(19, 4)
  verifiedAmount     Decimal?                  @db.Decimal(19, 4)
  currency           String                    @db.Char(3)
  verificationStatus PaymentVerificationStatus
  discrepancyReason  String?
  submittedById      String                    @db.Uuid
  verifiedById       String?                   @db.Uuid
  verifiedAt         DateTime?                 @db.Timestamptz(3)
  externalReference  String?                   @unique @db.VarChar(200)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  invoice            Invoice                   @relation(fields: [invoiceId, currency], references: [id, currency], onDelete: Restrict)
  submittedBy        User                      @relation("PaymentSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  verifiedBy         User?                     @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}
