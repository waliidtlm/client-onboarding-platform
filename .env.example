# Documentation template only. Never use these values against a running service.
# Every credential is intentionally fake. Replace all EXAMPLE_ONLY values after copying.

POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=example_platform_admin
POSTGRES_ADMIN_PASSWORD=EXAMPLE_ONLY_admin_password_NEVER_USE

APP_DB_NAME=onboarding_app
APP_DB_USER=example_onboarding_app_user
APP_DB_PASSWORD=EXAMPLE_ONLY_app_password_NEVER_USE

MIGRATION_DB_USER=example_onboarding_migration_user
MIGRATION_DB_PASSWORD=EXAMPLE_ONLY_migration_password_NEVER_USE

TEST_DB_NAME=onboarding_test
TEST_DB_USER=example_onboarding_test_user
TEST_DB_PASSWORD=EXAMPLE_ONLY_test_password_NEVER_USE

SHADOW_DB_NAME=onboarding_shadow

N8N_DB_NAME=n8n_internal
N8N_DB_USER=example_n8n_user
N8N_DB_PASSWORD=EXAMPLE_ONLY_n8n_password_NEVER_USE

# Keep the real value stable across n8n restarts.
N8N_ENCRYPTION_KEY=EXAMPLE_ONLY_n8n_encryption_key_NEVER_USE_000000
N8N_PORT=5678

# Dedicated n8n-to-application credentials. Replace these fake examples in .env.
AUTOMATION_SERVICE_TOKEN=EXAMPLE_ONLY_automation_service_token_NEVER_USE_000000
AUTOMATION_HMAC_SECRET=EXAMPLE_ONLY_automation_hmac_secret_NEVER_USE_00000000
AUTOMATION_PHASE5_SERVICE_TOKEN=EXAMPLE_ONLY_phase5_service_token_NEVER_USE_0000000000
AUTOMATION_PHASE5_HMAC_SECRET=EXAMPLE_ONLY_phase5_hmac_secret_NEVER_USE_000000000000
AUTOMATION_PHASE5_WORKER_ID=n8n-local-client-access
AUTOMATION_SIGNATURE_MAX_AGE_SECONDS=300
AUTOMATION_LEASE_SECONDS=300
AUTOMATION_MAX_ATTEMPTS=5
AUTOMATION_RETRY_BASE_SECONDS=30
AUTOMATION_WORKER_ID=n8n-local-primary
PROVISIONING_TASK_MAX_ATTEMPTS=3

# Used when the Next.js app runs directly on the host.
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
DATABASE_URL=postgresql://example_onboarding_app_user:EXAMPLE_ONLY_app_password_NEVER_USE@127.0.0.1:5432/onboarding_app
# Used only by Prisma migration commands.
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
MIGRATION_DATABASE_URL=postgresql://example_onboarding_migration_user:EXAMPLE_ONLY_migration_password_NEVER_USE@127.0.0.1:5432/onboarding_app
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
SHADOW_DATABASE_URL=postgresql://example_onboarding_migration_user:EXAMPLE_ONLY_migration_password_NEVER_USE@127.0.0.1:5432/onboarding_shadow
# Integration queries use the restricted test runtime user.
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
TEST_DATABASE_URL=postgresql://example_onboarding_test_user:EXAMPLE_ONLY_test_password_NEVER_USE@127.0.0.1:5432/onboarding_test
# Destructive test setup uses migration credentials only against onboarding_test.
# secretlint-disable-next-line -- This is an intentionally fake local-development example.
TEST_MIGRATION_DATABASE_URL=postgresql://example_onboarding_migration_user:EXAMPLE_ONLY_migration_password_NEVER_USE@127.0.0.1:5432/onboarding_test

# Replace in the ignored .env file. Never use this example value.
AUTH_SECRET=EXAMPLE_ONLY_auth_secret_NEVER_USE_000000000000
NEXTAUTH_URL=http://127.0.0.1:3000
DEMO_STAFF_PASSWORD=EXAMPLE_ONLY_demo_password_NEVER_USE
LOG_LEVEL=info
WEB_PORT=3000
PLAYWRIGHT_PORT=3100

# Phase 5 public access and object storage. All values below are fake examples.
CLIENT_ACCESS_ACTIVE_SIGNING_KEY_VERSION=1
CLIENT_ACCESS_SIGNING_KEYS={"1":"EXAMPLE_ONLY_base64url_signing_key_000000000000000000000"}
CLIENT_ACCESS_TOKEN_DAYS=30
CLIENT_ACCESS_PUBLIC_BASE_URL=http://127.0.0.1:3000/client-access
APP_PUBLIC_ORIGIN=http://127.0.0.1:3000
CLIENT_SESSION_SECRET=EXAMPLE_ONLY_base64url_session_secret_00000000000000000000
PUBLIC_RATE_LIMIT_HMAC_SECRET=EXAMPLE_ONLY_base64url_rate_limit_secret_000000000000000
TRUSTED_PROXY_HOPS=0
AGENCY_NAME=Northstar Growth Agency
CLIENT_SUPPORT_CONTACT=support@example.invalid

MINIO_ROOT_USER=example_minio_root
MINIO_ROOT_PASSWORD=EXAMPLE_ONLY_minio_root_password_NEVER_USE
