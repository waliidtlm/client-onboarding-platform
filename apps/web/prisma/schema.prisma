generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  OPERATIONS
  FINANCE
  PROJECT_MANAGER
  DELIVERY
}

enum ActivationType {
  FULL_PAYMENT_PERCENTAGE
  DEPOSIT_PERCENTAGE
  FIXED_DEPOSIT_AMOUNT
  MANUAL_APPROVAL
}

enum RequirementInputType {
  TEXT
  URL
  FILE
  MULTI_FILE
}

enum OnboardingStatus {
  SALES_HANDOFF_INCOMPLETE
  COMMERCIAL_PENDING
  READY_FOR_ONBOARDING
  INTERNAL_SETUP
  INTERNAL_REVIEW
  CLIENT_AWAITING_ACTION
  CLIENT_REQUIREMENTS_COMPLETE
  KICKOFF_PENDING
  PROJECT_READY
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum SalesHandoffStatus {
  PENDING_VALIDATION
  INCOMPLETE
  COMPLETE
}

enum DealStatus {
  OPEN
  CLOSED_WON
  CLOSED_LOST
}

enum CommercialGateStatus {
  BLOCKED
  PENDING_REVIEW
  APPROVED
  CANCELLED
}

enum CommercialGateBlocker {
  DEAL_NOT_CLOSED_WON
  CONTRACT_NOT_SIGNED
  ACTIVATION_AMOUNT_NOT_SATISFIED
  PAYMENT_REVIEW_REQUIRED
  COMMERCIAL_EXCEPTION_PENDING
  ONBOARDING_CANCELLED
}

enum ActivationRequirementStatus {
  NOT_SATISFIED
  MANUAL_REVIEW_REQUIRED
  SATISFIED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  REVISION_REQUESTED
  SIGNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REVIEW_REQUIRED
  REJECTED
}

enum SalesHandoffClientMode {
  EXISTING
  NEW
}

enum CommercialExceptionStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum AuditActorType {
  STAFF
  CLIENT
  SYSTEM
}

enum AutomationEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum AutomationRunStatus {
  PROCESSING
  COMPLETED
  FAILED
  TIMED_OUT
}

enum AutomationFailureClassification {
  RETRYABLE
  OPERATOR_REMEDIABLE
  PERMANENT
}

enum AutomationClaimOutcome {
  PENDING
  CLAIMED
  EMPTY
  REJECTED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  DELIVERY_UNCERTAIN
}

enum ProvisioningTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  MANUAL_REVIEW_REQUIRED
  MANUALLY_ACCEPTED
}

enum ProvisioningTaskAttemptStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  TIMED_OUT
}

enum ClientRequirementStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum RequirementReviewDecision {
  APPROVED
  REJECTED
}

enum FileUploadIntentStatus {
  PENDING
  FINALIZING
  FINALIZED
  REJECTED
  EXPIRED
}

model User {
  id                               String                @id @default(uuid()) @db.Uuid
  name                             String                @db.VarChar(200)
  email                            String                @unique @db.VarChar(320)
  passwordHash                     String                @db.VarChar(255)
  role                             Role
  isActive                         Boolean               @default(true)
  createdAt                        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                        DateTime              @updatedAt @db.Timestamptz(3)
  managedOnboardings               Onboarding[]          @relation("ProjectManager")
  submittedRecords                 Onboarding[]          @relation("SubmittedBy")
  validatedRecords                 Onboarding[]          @relation("ValidatedBy")
  manualActivationApprovals        Onboarding[]          @relation("ManualActivationApprovedBy")
  manualActivationRevocations      Onboarding[]          @relation("ManualActivationRevokedBy")
  submittedPayments                Payment[]             @relation("PaymentSubmittedBy")
  verifiedPayments                 Payment[]             @relation("PaymentVerifiedBy")
  openedCommercialExceptions       CommercialException[] @relation("CommercialExceptionCreatedBy")
  resolvedCommercialExceptions     CommercialException[] @relation("CommercialExceptionResolvedBy")
  auditEvents                      AuditEvent[]           @relation("AuditActor")
  manuallyAcceptedProvisioningTasks ProvisioningTask[]    @relation("ProvisioningTaskManuallyAcceptedBy")
  internalReadinessApprovals       Onboarding[]           @relation("InternalReadinessApprovedBy")
  resolvedAutomationEvents         AutomationEvent[]      @relation("AutomationEventResolvedBy")
  approvedClientRequirements       ClientRequirement[]     @relation("ClientRequirementApprovedBy")
  reviewedRequirementSubmissions   RequirementSubmission[] @relation("RequirementSubmissionReviewedBy")
}

model Client {
  id           String       @id @default(uuid()) @db.Uuid
  companyName  String       @unique @db.VarChar(200)
  contactName  String       @db.VarChar(200)
  contactEmail String       @db.VarChar(320)
  contactPhone String?      @db.VarChar(50)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  onboardings  Onboarding[]
  salesHandoffs SalesHandoff[]
}

model ServicePackage {
  id                    String                        @id @default(uuid()) @db.Uuid
  name                  String                        @unique @db.VarChar(200)
  description           String
  isActive              Boolean                       @default(true)
  activationType        ActivationType
  activationValue       Decimal                       @db.Decimal(19, 4)
  createdAt             DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                      @updatedAt @db.Timestamptz(3)
  provisioningTemplates PackageProvisioningTemplate[]
  requirementTemplates  PackageRequirementTemplate[]
  onboardings           Onboarding[]
  salesHandoffs         SalesHandoff[]
}

model PackageProvisioningTemplate {
  id               String         @id @default(uuid()) @db.Uuid
  servicePackageId String         @db.Uuid
  name             String         @db.VarChar(200)
  description      String
  sequence         Int
  isRequired       Boolean        @default(true)
  automationKey    String         @db.VarChar(100)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)
  provisioningTasks ProvisioningTask[]

  @@unique([servicePackageId, sequence])
  @@unique([servicePackageId, automationKey])
}

model PackageRequirementTemplate {
  id               String               @id @default(uuid()) @db.Uuid
  servicePackageId String               @db.Uuid
  name             String               @db.VarChar(200)
  description      String
  inputType        RequirementInputType
  isRequired       Boolean              @default(true)
  sequence         Int
  dueOffsetDays    Int
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  servicePackage   ServicePackage       @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)
  clientRequirements ClientRequirement[]

  @@unique([servicePackageId, sequence])
}

model Onboarding {
  id                          String                      @id @default(uuid()) @db.Uuid
  clientId                    String?                     @db.Uuid
  servicePackageId            String?                     @db.Uuid
  externalDealId              String?                     @unique @db.VarChar(200)
  dealStatus                  DealStatus?
  salesHandoffStatus          SalesHandoffStatus
  commercialGateStatus        CommercialGateStatus
  commercialGateBlockingReasons CommercialGateBlocker[]  @default([])
  commercialGateEvaluatedAt   DateTime?                   @db.Timestamptz(3)
  status                      OnboardingStatus
  projectManagerId            String?                     @db.Uuid
  submittedById               String                      @db.Uuid
  validatedById               String?                     @db.Uuid
  invoiceTotal                Decimal?                    @db.Decimal(19, 4)
  currency                    String?                     @db.Char(3)
  servicePackageNameSnapshot  String?                     @db.VarChar(200)
  activationTypeSnapshot      ActivationType?
  activationValueSnapshot     Decimal?                    @db.Decimal(19, 4)
  activationRequiredAmount    Decimal?                    @db.Decimal(19, 4)
  activationRequirementStatus ActivationRequirementStatus
  activationInvoiceId         String?                     @unique @db.Uuid
  manualActivationApprovedById String?                    @db.Uuid
  manualActivationApprovedAt  DateTime?                   @db.Timestamptz(3)
  manualActivationRevokedById String?                     @db.Uuid
  manualActivationRevokedAt   DateTime?                   @db.Timestamptz(3)
  manualActivationRevocationReason String?
  activatedAt                 DateTime?                   @db.Timestamptz(3)
  welcomeEmailSentAt          DateTime?                   @db.Timestamptz(3)
  clientAccessDeliveredAt     DateTime?                   @db.Timestamptz(3)
  requirementsGenerationKey   String?                     @unique @db.VarChar(255)
  requirementsGeneratedAt     DateTime?                   @db.Timestamptz(3)
  requirementsCompletedAt     DateTime?                   @db.Timestamptz(3)
  projectReadyAt              DateTime?                   @db.Timestamptz(3)
  completedAt                 DateTime?                   @db.Timestamptz(3)
  cancelledAt                 DateTime?                   @db.Timestamptz(3)
  cancellationReason          String?
  version                     Int                         @default(1)
  createdAt                   DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                    @updatedAt @db.Timestamptz(3)
  client                      Client?                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  servicePackage              ServicePackage?             @relation(fields: [servicePackageId], references: [id], onDelete: Restrict)
  projectManager              User?                       @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  submittedBy                 User                        @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  validatedBy                 User?                       @relation("ValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  manualActivationApprovedBy  User?                       @relation("ManualActivationApprovedBy", fields: [manualActivationApprovedById], references: [id], onDelete: Restrict)
  manualActivationRevokedBy   User?                       @relation("ManualActivationRevokedBy", fields: [manualActivationRevokedById], references: [id], onDelete: Restrict)
  salesHandoff                SalesHandoff?
  contracts                   Contract[]
  invoices                    Invoice[]                   @relation("OnboardingInvoices")
  activationInvoice           Invoice?                    @relation("ActivationInvoice", fields: [activationInvoiceId], references: [id], onDelete: Restrict)
  commercialExceptions        CommercialException[]
  auditEvents                 AuditEvent[]
  automationEvents            AutomationEvent[]
  notificationLogs            NotificationLog[]
  provisioningTasks           ProvisioningTask[]
  clientRequirements          ClientRequirement[]
  clientAccessTokens          ClientAccessToken[]
  fileUploadIntents           FileUploadIntent[]
  fileAssets                  FileAsset[]
  internalReadinessApprovedById String?                   @db.Uuid
  internalReadinessApprovedAt DateTime?                   @db.Timestamptz(3)
  internalReadinessNote       String?
  internalReadinessApprovedBy User?                       @relation("InternalReadinessApprovedBy", fields: [internalReadinessApprovedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([projectManagerId])
}

model SalesHandoff {
  id                    String                  @id @default(uuid()) @db.Uuid
  onboardingId          String                  @unique @db.Uuid
  submissionKey         String                  @unique @db.VarChar(100)
  externalDealId        String?                 @unique @db.VarChar(200)
  clientMode            SalesHandoffClientMode?
  existingClientId      String?                 @db.Uuid
  newClientCompanyName  String?                 @db.VarChar(200)
  newClientContactName  String?                 @db.VarChar(200)
  newClientContactEmail String?                 @db.VarChar(320)
  newClientContactPhone String?                 @db.VarChar(50)
  servicePackageId      String?                 @db.Uuid
  dealStatus            DealStatus?
  agreedTotal           Decimal?                @db.Decimal(19, 4)
  currency              String?                 @db.Char(3)
  salesNotes            String?
  validationErrors      Json?
  version               Int                     @default(1)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  onboarding            Onboarding              @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  existingClient        Client?                 @relation(fields: [existingClientId], references: [id], onDelete: Restrict)
  servicePackage        ServicePackage?         @relation(fields: [servicePackageId], references: [id], onDelete: Restrict)

  @@index([servicePackageId])
}

model Contract {
  id                String         @id @default(uuid()) @db.Uuid
  onboardingId      String         @db.Uuid
  status            ContractStatus
  versionNumber     Int
  signatureDeadline DateTime?      @db.Timestamptz(3)
  signedAt          DateTime?      @db.Timestamptz(3)
  revisionReason    String?
  externalReference String?        @unique @db.VarChar(200)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  onboarding        Onboarding     @relation(fields: [onboardingId], references: [id], onDelete: Restrict)

  @@unique([onboardingId, versionNumber])
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  onboardingId      String        @db.Uuid
  status            InvoiceStatus
  invoiceNumber     String?       @unique @db.VarChar(100)
  totalAmount       Decimal       @db.Decimal(19, 4)
  currency          String        @db.Char(3)
  dueAt             DateTime?     @db.Timestamptz(3)
  overdueAt         DateTime?     @db.Timestamptz(3)
  externalReference String?       @unique @db.VarChar(200)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  onboarding        Onboarding    @relation("OnboardingInvoices", fields: [onboardingId], references: [id], onDelete: Restrict)
  activationForOnboarding Onboarding? @relation("ActivationInvoice")
  payments          Payment[]

  @@unique([id, currency])
  @@index([onboardingId])
}

model Payment {
  id                 String                    @id @default(uuid()) @db.Uuid
  invoiceId          String                    @db.Uuid
  originalAmount     Decimal                   @db.Decimal(19, 4)
  verifiedAmount     Decimal?                  @db.Decimal(19, 4)
  currency           String                    @db.Char(3)
  verificationStatus PaymentVerificationStatus
  discrepancyReason  String?
  submittedById      String                    @db.Uuid
  verifiedById       String?                   @db.Uuid
  verifiedAt         DateTime?                 @db.Timestamptz(3)
  externalReference  String?                   @unique @db.VarChar(200)
  recordingKey       String                    @unique @db.VarChar(100)
  version            Int                       @default(1)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  invoice            Invoice                   @relation(fields: [invoiceId, currency], references: [id, currency], onDelete: Restrict)
  submittedBy        User                      @relation("PaymentSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  verifiedBy         User?                     @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model CommercialException {
  id           String                    @id @default(uuid()) @db.Uuid
  onboardingId String                    @db.Uuid
  status       CommercialExceptionStatus @default(OPEN)
  reason       String
  createdById  String                    @db.Uuid
  resolvedById String?                   @db.Uuid
  resolutionNote String?
  resolvedAt   DateTime?                 @db.Timestamptz(3)
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @db.Timestamptz(3)
  onboarding   Onboarding                @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  createdBy    User                      @relation("CommercialExceptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy   User?                     @relation("CommercialExceptionResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([onboardingId, status])
}

model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  onboardingId  String         @db.Uuid
  actorType      AuditActorType
  actorId        String?        @db.Uuid
  clientAccessTokenId String?   @db.Uuid
  action         String         @db.VarChar(100)
  entityType     String         @db.VarChar(100)
  entityId       String         @db.VarChar(200)
  previousValue  Json?
  newValue       Json?
  metadata       Json?
  correlationId  String         @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  onboarding     Onboarding     @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  actor          User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  clientAccessToken ClientAccessToken? @relation(fields: [clientAccessTokenId], references: [id], onDelete: Restrict)

  @@index([onboardingId, createdAt])
  @@index([correlationId])
}

model AutomationEvent {
  id                 String                 @id @default(uuid()) @db.Uuid
  eventType          String                 @db.VarChar(100)
  aggregateType      String                 @db.VarChar(100)
  aggregateId        String                 @db.Uuid
  payload            Json                   @default("{}")
  schemaVersion      Int
  status             AutomationEventStatus  @default(PENDING)
  attemptCount       Int                    @default(0)
  maxAttempts        Int
  availableAt        DateTime               @db.Timestamptz(3)
  occurredAt         DateTime               @db.Timestamptz(3)
  processedAt        DateTime?              @db.Timestamptz(3)
  lastErrorCode      String?                @db.VarChar(100)
  lastError          String?                @db.VarChar(1000)
  correlationId      String                 @db.Uuid
  deduplicationKey   String                 @unique @db.VarChar(255)
  claimedBy          String?                @db.VarChar(100)
  claimedAt          DateTime?              @db.Timestamptz(3)
  leaseExpiresAt     DateTime?              @db.Timestamptz(3)
  currentRunId       String?                @unique @db.Uuid
  resolvedById       String?                @db.Uuid
  resolvedAt         DateTime?              @db.Timestamptz(3)
  resolutionCode     String?                @db.VarChar(100)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  onboarding         Onboarding             @relation(fields: [aggregateId], references: [id], onDelete: Restrict)
  runs               AutomationRun[]        @relation("AutomationEventRuns")
  currentRun         AutomationRun?         @relation("CurrentAutomationRun", fields: [currentRunId], references: [id], onDelete: Restrict)
  claimRequests      AutomationClaimRequest[]
  resolvedBy         User?                  @relation("AutomationEventResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@index([leaseExpiresAt])
}

model AutomationRun {
  id                    String                           @id @default(uuid()) @db.Uuid
  automationEventId     String                           @db.Uuid
  workflowName          String                           @db.VarChar(200)
  workerId              String                           @db.VarChar(100)
  n8nExecutionId        String?                          @db.VarChar(100)
  claimRequestId        String                           @unique @db.Uuid
  idempotencyKey        String                           @unique @db.VarChar(255)
  status                AutomationRunStatus              @default(PROCESSING)
  attemptNumber         Int
  startedAt             DateTime                         @db.Timestamptz(3)
  completedAt           DateTime?                        @db.Timestamptz(3)
  errorCode             String?                          @db.VarChar(100)
  errorMessage          String?                          @db.VarChar(1000)
  failedNode            String?                          @db.VarChar(200)
  failureClassification AutomationFailureClassification?
  failureReportedAt     DateTime?                        @db.Timestamptz(3)
  resultReferences      Json?
  createdAt             DateTime                         @default(now()) @db.Timestamptz(3)
  automationEvent       AutomationEvent                  @relation("AutomationEventRuns", fields: [automationEventId], references: [id], onDelete: Restrict)
  currentForEvent       AutomationEvent?                 @relation("CurrentAutomationRun")
  provisioningAttempts  ProvisioningTaskAttempt[]

  @@unique([automationEventId, attemptNumber])
  @@unique([workerId, n8nExecutionId])
  @@index([automationEventId, createdAt])
}

model AutomationClaimRequest {
  requestId         String                 @id @db.Uuid
  workerId          String                 @db.VarChar(100)
  workflowName      String                 @db.VarChar(200)
  requestFingerprint String                @db.Char(64)
  supportedEventTypes String[]
  outcome           AutomationClaimOutcome @default(PENDING)
  automationEventId String?                @db.Uuid
  errorCode         String?                @db.VarChar(100)
  expiresAt         DateTime               @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  automationEvent   AutomationEvent?       @relation(fields: [automationEventId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
}

model NotificationLog {
  id                 String              @id @default(uuid()) @db.Uuid
  onboardingId       String              @db.Uuid
  notificationType   String              @db.VarChar(100)
  recipient          String              @db.VarChar(320)
  channel            NotificationChannel
  status             NotificationStatus
  idempotencyKey     String              @unique @db.VarChar(255)
  senderKey          String              @db.VarChar(100)
  senderName         String              @db.VarChar(200)
  senderAddress      String              @db.VarChar(320)
  subject            String              @db.VarChar(500)
  textContent        String
  htmlContent        String?
  templateVersion    Int
  messageKey         String              @unique @db.VarChar(255)
  attemptCount       Int                 @default(0)
  deliveryAttemptKey String?             @unique @db.VarChar(255)
  deliveryStartedAt  DateTime?           @db.Timestamptz(3)
  providerReference  String?             @db.VarChar(500)
  sentAt             DateTime?           @db.Timestamptz(3)
  failureReason      String?             @db.VarChar(1000)
  clientAccessTokenId String?            @unique @db.Uuid
  clientCompanySnapshot String?          @db.VarChar(200)
  agencyNameSnapshot String?             @db.VarChar(200)
  supportContactSnapshot String?         @db.VarChar(320)
  publicBaseUrlSnapshot String?          @db.VarChar(500)
  fragmentFormatSnapshot String?         @db.VarChar(100)
  tokenExpiresAtSnapshot DateTime?       @db.Timestamptz(3)
  tokenSigningKeyVersionSnapshot Int?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  onboarding         Onboarding          @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  clientAccessToken  ClientAccessToken?  @relation(fields: [clientAccessTokenId], references: [id], onDelete: Restrict)

  @@index([onboardingId, createdAt])
}

model ProvisioningTask {
  id                       String                 @id @default(uuid()) @db.Uuid
  onboardingId             String                 @db.Uuid
  templateId               String                 @db.Uuid
  name                     String                 @db.VarChar(200)
  description              String
  sequence                 Int
  isRequired               Boolean                @default(true)
  automationKey            String                 @db.VarChar(100)
  status                   ProvisioningTaskStatus @default(PENDING)
  attemptCount             Int                    @default(0)
  maxAttempts              Int
  lastErrorCode            String?                @db.VarChar(100)
  lastErrorMessage         String?                @db.VarChar(1000)
  externalReference        String?                @db.VarChar(500)
  idempotencyKey           String                 @unique @db.VarChar(255)
  startedAt                DateTime?               @db.Timestamptz(3)
  completedAt              DateTime?               @db.Timestamptz(3)
  manuallyAcceptedById     String?                @db.Uuid
  manuallyAcceptedAt       DateTime?               @db.Timestamptz(3)
  manualAcceptanceReason   String?
  version                  Int                    @default(1)
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(3)
  onboarding               Onboarding             @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  template                 PackageProvisioningTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  manuallyAcceptedBy       User?                  @relation("ProvisioningTaskManuallyAcceptedBy", fields: [manuallyAcceptedById], references: [id], onDelete: Restrict)
  attempts                 ProvisioningTaskAttempt[]
  sandboxResource          SandboxProvisionedResource?

  @@unique([onboardingId, templateId])
  @@unique([onboardingId, sequence])
  @@index([onboardingId, status, sequence])
}

model ProvisioningTaskAttempt {
  id                 String                        @id @default(uuid()) @db.Uuid
  provisioningTaskId String                        @db.Uuid
  automationRunId    String                        @unique @db.Uuid
  attemptNumber      Int
  status             ProvisioningTaskAttemptStatus @default(IN_PROGRESS)
  retryable          Boolean?
  errorCode          String?                       @db.VarChar(100)
  errorMessage       String?                       @db.VarChar(1000)
  externalReference  String?                       @db.VarChar(500)
  startedAt          DateTime                      @db.Timestamptz(3)
  completedAt        DateTime?                     @db.Timestamptz(3)
  createdAt          DateTime                      @default(now()) @db.Timestamptz(3)
  provisioningTask   ProvisioningTask              @relation(fields: [provisioningTaskId], references: [id], onDelete: Restrict)
  automationRun      AutomationRun                 @relation(fields: [automationRunId], references: [id], onDelete: Restrict)

  @@unique([provisioningTaskId, attemptNumber])
  @@index([provisioningTaskId, createdAt])
}

model SandboxProvisionedResource {
  id                 String           @id @default(uuid()) @db.Uuid
  provisioningTaskId String           @unique @db.Uuid
  idempotencyKey     String           @unique @db.VarChar(255)
  resourceType       String           @db.VarChar(100)
  displayName        String           @db.VarChar(300)
  externalReference  String           @unique @db.VarChar(500)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  provisioningTask   ProvisioningTask @relation(fields: [provisioningTaskId], references: [id], onDelete: Restrict)
}

model ClientRequirement {
  id                       String                  @id @default(uuid()) @db.Uuid
  onboardingId             String                  @db.Uuid
  templateId               String                  @db.Uuid
  name                     String                  @db.VarChar(200)
  description              String
  inputType                RequirementInputType
  isRequired               Boolean
  sequence                 Int
  dueOffsetDays            Int
  dueAt                    DateTime?               @db.Timestamptz(3)
  status                   ClientRequirementStatus @default(PENDING)
  currentSubmissionVersion Int                     @default(0)
  reviewingSubmissionVersion Int?
  approvedById             String?                 @db.Uuid
  approvedAt               DateTime?               @db.Timestamptz(3)
  version                  Int                     @default(1)
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(3)
  onboarding               Onboarding              @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  template                 PackageRequirementTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  approvedBy               User?                   @relation("ClientRequirementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  submissions              RequirementSubmission[]
  uploadIntents            FileUploadIntent[]
  fileAssets               FileAsset[]

  @@unique([onboardingId, templateId])
  @@unique([onboardingId, sequence])
  @@index([onboardingId, status, sequence])
}

model RequirementSubmission {
  id                       String                    @id @default(uuid()) @db.Uuid
  requirementId            String                    @db.Uuid
  submissionVersion        Int
  textValue                String?
  urlValue                 String?                   @db.VarChar(2048)
  submittedViaTokenId      String                    @db.Uuid
  submissionIdempotencyKey String                    @db.VarChar(255)
  requestFingerprint       String                    @db.Char(64)
  submittedAt              DateTime                  @db.Timestamptz(3)
  reviewedAt               DateTime?                 @db.Timestamptz(3)
  reviewedById             String?                   @db.Uuid
  reviewDecision           RequirementReviewDecision?
  reviewReason             String?
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  requirement              ClientRequirement         @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  submittedViaToken        ClientAccessToken         @relation(fields: [submittedViaTokenId], references: [id], onDelete: Restrict)
  reviewedBy               User?                     @relation("RequirementSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  files                    FileAsset[]

  @@unique([requirementId, submissionVersion])
  @@unique([requirementId, submissionIdempotencyKey])
  @@index([requirementId, createdAt])
}

model ClientAccessToken {
  id                 String              @id @default(uuid()) @db.Uuid
  onboardingId       String              @db.Uuid
  tokenHash          String              @unique @db.Char(64)
  tokenNonce         String              @db.VarChar(43)
  tokenVersion       Int
  signingKeyVersion  Int
  issueSequence      Int
  issuanceKey        String              @unique @db.VarChar(255)
  requestFingerprint String              @db.Char(64)
  expiresAt          DateTime            @db.Timestamptz(3)
  revokedAt          DateTime?           @db.Timestamptz(3)
  revocationReason   String?
  replacedById       String?             @unique @db.Uuid
  lastUsedAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  onboarding         Onboarding          @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  replacedBy         ClientAccessToken?  @relation("ClientAccessReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces           ClientAccessToken?  @relation("ClientAccessReplacement")
  notification       NotificationLog?
  submissions        RequirementSubmission[]
  uploadIntents      FileUploadIntent[]
  auditEvents        AuditEvent[]

  @@unique([onboardingId, issueSequence])
  @@index([onboardingId, expiresAt])
}

model FileUploadIntent {
  id                  String                 @id @default(uuid()) @db.Uuid
  clientAccessTokenId String                 @db.Uuid
  onboardingId        String                 @db.Uuid
  requirementId       String                 @db.Uuid
  expectedInputType   RequirementInputType
  uploadStorageKey    String                 @unique @db.VarChar(500)
  finalStorageKey     String                 @unique @db.VarChar(500)
  originalFilename    String                 @db.VarChar(255)
  declaredMimeType    String                 @db.VarChar(200)
  declaredSizeBytes   BigInt
  declaredChecksum    String                 @db.Char(64)
  status              FileUploadIntentStatus @default(PENDING)
  failureCode         String?                @db.VarChar(100)
  idempotencyKey      String                 @db.VarChar(255)
  requestFingerprint  String                 @db.Char(64)
  expiresAt           DateTime               @db.Timestamptz(3)
  finalizedAt         DateTime?              @db.Timestamptz(3)
  version             Int                    @default(1)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)
  clientAccessToken   ClientAccessToken      @relation(fields: [clientAccessTokenId], references: [id], onDelete: Restrict)
  onboarding          Onboarding             @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  requirement         ClientRequirement      @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  fileAsset           FileAsset?

  @@unique([clientAccessTokenId, idempotencyKey])
  @@index([status, expiresAt])
  @@index([onboardingId, requirementId])
}

model FileAsset {
  id                      String                 @id @default(uuid()) @db.Uuid
  onboardingId            String                 @db.Uuid
  requirementId           String                 @db.Uuid
  uploadIntentId          String                 @unique @db.Uuid
  requirementSubmissionId String?                @db.Uuid
  storageKey              String                 @unique @db.VarChar(500)
  originalFilename        String                 @db.VarChar(255)
  mimeType                String                 @db.VarChar(200)
  sizeBytes               BigInt
  checksum                String                 @db.Char(64)
  displayOrder            Int?
  uploadedAt              DateTime               @db.Timestamptz(3)
  finalizedAt             DateTime               @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  onboarding              Onboarding             @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  requirement             ClientRequirement      @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  uploadIntent            FileUploadIntent       @relation(fields: [uploadIntentId], references: [id], onDelete: Restrict)
  requirementSubmission   RequirementSubmission? @relation(fields: [requirementSubmissionId], references: [id], onDelete: Restrict)

  @@index([onboardingId, requirementId])
  @@index([requirementSubmissionId, displayOrder])
}

model PublicRateLimitBucket {
  id               String   @id @default(uuid()) @db.Uuid
  scope            String   @db.VarChar(100)
  subjectHash      String   @db.Char(64)
  windowStartedAt  DateTime @db.Timestamptz(3)
  count            Int
  expiresAt        DateTime @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@unique([scope, subjectHash, windowStartedAt])
  @@index([expiresAt])
}
